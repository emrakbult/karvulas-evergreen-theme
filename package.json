{
    "name": "karvulas-evergreen-theme",
    "displayName": "Karvulas Evergreen Theme",
    "description": "A light Visual Studio Code theme with language-specific syntax colors.",
    "version": "0.4.2",
    "icon": "logo.png",
    "publisher": "Karvulas",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/emrakbult/karvulas-evergreen-theme.git"
    },
    "engines": {
        "vscode": "^1.90.0"
    },
    "categories": [
        "Themes"
    ],
    "keywords": [
        "theme",
        "light",
        "evergreen",
        "karvulas"
    ],
    "extensionKind": [
        "ui"
    ],
    "contributes": {
        "markdown.previewStyles": [
            "./themes/karvulas-evergreen-markdown-preview.css"
        ],
        "themes": [
            {
                "label": "Karvulas Evergreen Light",
                "uiTheme": "vs",
                "path": "./themes/karvulas-evergreen-light-color-theme.json"
            }
        ]
    }
}
