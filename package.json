{
    "name": "karvulas-evergreen-theme",
    "displayName": "Karvulas Evergreen Theme",
    "description": "A light Visual Studio Code theme with language-specific syntax colors.",
    "version": "0.7.1",
    "icon": "logo.png",
    "publisher": "Karvulas",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/emrakbult/karvulas-evergreen-theme.git"
    },
    "engines": {
        "vscode": "^1.90.0"
    },
    "categories": [
        "Themes"
    ],
    "keywords": [
        "theme",
        "light",
        "evergreen",
        "karvulas"
    ],
    "extensionKind": [
        "ui"
    ],
    "contributes": {
        "languages": [
            {
                "id": "karvulas-csv",
                "aliases": ["Karvulas CSV"],
                "extensions": [".csv"],
                "mimetypes": ["text/csv"]
            },
            {
                "id": "toml",
                "aliases": ["TOML"],
                "extensions": [".toml"],
                "filenames": ["Cargo.lock", "uv.lock"],
                "configuration": "./syntaxes/karvulas-toml-language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "karvulas-csv",
                "scopeName": "source.csv.karvulas",
                "path": "./syntaxes/karvulas-csv.tmLanguage.json"
            },
            {
                "scopeName": "karvulas.rust.keywords",
                "path": "./syntaxes/karvulas-rust-keywords.tmLanguage.json",
                "injectTo": ["source.rust"]
            },
            {
                "language": "toml",
                "scopeName": "source.toml",
                "path": "./syntaxes/karvulas-toml.tmLanguage.json"
            }
        ],
        "markdown.previewStyles": [
            "./themes/karvulas-evergreen-markdown-preview.css"
        ],
        "themes": [
            {
                "label": "Karvulas Evergreen Light",
                "uiTheme": "vs",
                "path": "./themes/karvulas-evergreen-light-color-theme.json"
            }
        ]
    }
}
